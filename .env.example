# ─────────────────────────────────────────────────────────────
# PUBLIC values — safe to ship in the app bundle (EXPO_PUBLIC_*)
# Copy this file to `.env` and fill in your own values.
# ─────────────────────────────────────────────────────────────

# Supabase project (Project Settings → API Keys)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# New key system — the publishable key (starts with sb_publishable_...).
# Safe to ship in the app. (Legacy projects can use the anon key here instead.)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# EAS build project id (optional until you run `eas build`)
EAS_PROJECT_ID=

# ─────────────────────────────────────────────────────────────
# SECRETS — do NOT put these in .env for the app.
# Set them on the Supabase Edge Functions instead:
#   supabase secrets set OPENAI_API_KEY=sk-...
# The app never sees the OpenAI key; it calls the edge function.
# ─────────────────────────────────────────────────────────────
