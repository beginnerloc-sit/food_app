# ─────────────────────────────────────────────────────────────
# PUBLIC values — safe to ship in the app bundle (EXPO_PUBLIC_*)
# Copy this file to `.env` and fill in your own values.
# ─────────────────────────────────────────────────────────────

# Supabase project (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google OAuth client IDs (Google Cloud Console → Credentials)
# You need one per platform. The web client id is also used by Expo Go / web.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Spoonacular (dietary meal-prep articles + recipes) — https://spoonacular.com/food-api
EXPO_PUBLIC_MEALPREP_API_KEY=your-spoonacular-key

# EAS build project id (optional until you run `eas build`)
EAS_PROJECT_ID=

# ─────────────────────────────────────────────────────────────
# SECRETS — do NOT put these in .env for the app.
# Set them on the Supabase Edge Functions instead:
#   supabase secrets set OPENAI_API_KEY=sk-...
# The app never sees the OpenAI key; it calls the edge function.
# ─────────────────────────────────────────────────────────────
